{# FR-11.4 -- Trip index template. Implemented in task T5.4. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trip Index &mdash; Raleigh Commute Digital Twin</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: #1e1e2e;
    color: #cdd6f4;
    padding: 0 0 48px;
  }
  a { color: #89b4fa; text-decoration: none; }
  a:hover { text-decoration: underline; }

  .header {
    background: linear-gradient(135deg, #181825 0%, #313244 100%);
    border-bottom: 2px solid #585b70;
    padding: 22px 32px 18px;
  }
  .header h1 { font-size: 1.5rem; font-weight: 700; }
  .header .sub { font-size: 0.82rem; color: #6c7086; margin-top: 4px; }

  .stats-strip {
    display: flex; gap: 12px; flex-wrap: wrap;
    margin: 20px 32px 0;
  }
  .stat-card {
    background: #181825; border: 1px solid #45475a; border-radius: 8px;
    padding: 10px 18px; min-width: 110px;
  }
  .stat-val { font-size: 1.4rem; font-weight: 700; color: #89dceb; }
  .stat-key { font-size: 0.72rem; color: #6c7086; text-transform: uppercase;
               letter-spacing: 0.06em; margin-top: 2px; }

  .rho-box {
    margin: 16px 32px 0;
    background: #181825; border: 1px solid #45475a; border-radius: 8px;
    padding: 10px 20px; display: inline-block;
  }
  .rho-label { font-size: 0.78rem; color: #6c7086; }
  .rho-val { font-size: 1.1rem; font-weight: 700; color: #cba6f7; }

  .section { margin: 24px 32px 0; }
  .section-title {
    font-size: 0.85rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.08em; color: #a6adc8; margin-bottom: 10px;
    padding-bottom: 6px; border-bottom: 1px solid #313244;
  }

  table {
    width: 100%; border-collapse: collapse;
    font-size: 0.88rem; background: #181825;
    border: 1px solid #313244; border-radius: 10px; overflow: hidden;
  }
  thead th {
    padding: 10px 12px; text-align: left;
    color: #6c7086; font-size: 0.75rem; text-transform: uppercase;
    letter-spacing: 0.06em; background: #1e1e2e;
    cursor: pointer; user-select: none; white-space: nowrap;
  }
  thead th:hover { color: #cdd6f4; }
  thead th .sort-icon { font-size: 0.65rem; margin-left: 4px; }
  tbody tr { border-top: 1px solid #313244; }
  tbody tr:hover { background: #252535; }
  tbody td { padding: 9px 12px; }

  .score-chip {
    display: inline-block; min-width: 48px; text-align: center;
    border-radius: 4px; padding: 2px 7px;
    font-family: monospace; font-weight: 700; font-size: 0.92rem;
  }
  .score-green { background: #1e3a2f; color: #a6e3a1; }
  .score-amber { background: #3a3020; color: #f9e2af; }
  .score-red   { background: #3a1f22; color: #f38ba8; }

  .star { color: #f9e2af; }
  .no-rating { color: #45475a; }

  .footer {
    margin: 32px 32px 0; font-size: 0.72rem; color: #45475a;
    border-top: 1px solid #313244; padding-top: 12px;
  }
</style>
</head>
<body>

<div class="header">
  <h1>&#128661; Trip Index &mdash; Raleigh Commute Digital Twin</h1>
  <div class="sub">Generated {{ generated_at }} &nbsp;&middot;&nbsp; {{ n_trips }} trip(s) scored</div>
</div>

<div class="stats-strip">
  <div class="stat-card">
    <div class="stat-val">{{ n_trips }}</div>
    <div class="stat-key">Trips scored</div>
  </div>
  <div class="stat-card">
    <div class="stat-val">{{ n_rated }}</div>
    <div class="stat-key">Rated</div>
  </div>
  {% if rows %}
  <div class="stat-card">
    <div class="stat-val">{{ "%.1f"|format(rows | map(attribute="score_0_100") | list | sum / rows|length) }}</div>
    <div class="stat-key">Avg score</div>
  </div>
  {% endif %}
</div>

<div class="rho-box">
  <div class="rho-label">Spearman &rho; (tool vs. subjective)</div>
  <div class="rho-val">{{ rho_info.display }}</div>
</div>

<div class="section">
  <div class="section-title">&#128203; All Trips</div>
  <table id="trip-table">
    <thead>
      <tr>
        <th onclick="sortTable(0)" data-col="0">Trip ID <span class="sort-icon">&#8597;</span></th>
        <th onclick="sortTable(1)" data-col="1">Score <span class="sort-icon">&#8597;</span></th>
        <th onclick="sortTable(2)" data-col="2">Tip % <span class="sort-icon">&#8597;</span></th>
        <th onclick="sortTable(3)" data-col="3">Band <span class="sort-icon">&#8597;</span></th>
        <th onclick="sortTable(4)" data-col="4">Filter <span class="sort-icon">&#8597;</span></th>
        <th onclick="sortTable(5)" data-col="5">Rating <span class="sort-icon">&#8597;</span></th>
        <th onclick="sortTable(6)" data-col="6">Scored at <span class="sort-icon">&#8597;</span></th>
        <th>Report</th>
      </tr>
    </thead>
    <tbody>
    {% for row in rows %}
    <tr>
      <td>{{ row.trip_id }}</td>
      <td>
        {% if row.score_0_100 >= 80 %}
          <span class="score-chip score-green">{{ "%.1f"|format(row.score_0_100) }}</span>
        {% elif row.score_0_100 >= 60 %}
          <span class="score-chip score-amber">{{ "%.1f"|format(row.score_0_100) }}</span>
        {% else %}
          <span class="score-chip score-red">{{ "%.1f"|format(row.score_0_100) }}</span>
        {% endif %}
      </td>
      <td>{{ row.suggested_tip_pct }}%</td>
      <td>{{ row.suggested_tip_band }}</td>
      <td style="font-family:monospace; color:#6c7086;">{{ row.fused_source | upper }}</td>
      <td>
        {% if row.rating is not none %}
          <span class="star">{{ "★" * row.rating }}{{ "☆" * (5 - row.rating) }}</span>
        {% else %}
          <span class="no-rating">&mdash;</span>
        {% endif %}
      </td>
      <td style="font-family:monospace; font-size:0.8rem; color:#6c7086;">
        {{ row.timestamp_utc[:10] if row.timestamp_utc else "—" }}
      </td>
      <td>
        {% if row.report_link %}
          <a href="{{ row.report_link }}">&#128196; open</a>
        {% else %}
          <span class="no-rating">—</span>
        {% endif %}
      </td>
    </tr>
    {% else %}
    <tr><td colspan="8" style="text-align:center; color:#45475a; padding:20px;">
      No scored trips found. Run <code>make score TRACE=day2</code> first.
    </td></tr>
    {% endfor %}
    </tbody>
  </table>
</div>

<div class="footer">
  Raleigh Commute Digital Twin &nbsp;&middot;&nbsp; {{ generated_at }}
  &nbsp;&middot;&nbsp; Spearman &rho; requires &ge; 5 rated trips.
</div>

<script>
/* Vanilla JS client-side sort -- no framework */
(function () {
  var currentCol = -1;
  var ascending = true;

  window.sortTable = function (col) {
    var table = document.getElementById("trip-table");
    var tbody = table.tBodies[0];
    var rows = Array.from(tbody.querySelectorAll("tr"));

    if (currentCol === col) {
      ascending = !ascending;
    } else {
      currentCol = col;
      ascending = true;
    }

    rows.sort(function (a, b) {
      var aVal = a.cells[col] ? a.cells[col].innerText.trim() : "";
      var bVal = b.cells[col] ? b.cells[col].innerText.trim() : "";
      var aNum = parseFloat(aVal.replace(/[^0-9.\-]/g, ""));
      var bNum = parseFloat(bVal.replace(/[^0-9.\-]/g, ""));
      if (!isNaN(aNum) && !isNaN(bNum)) {
        return ascending ? aNum - bNum : bNum - aNum;
      }
      return ascending ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
    });

    rows.forEach(function (r) { tbody.appendChild(r); });

    /* Update sort icon direction */
    var headers = table.querySelectorAll("thead th");
    headers.forEach(function (th, i) {
      var icon = th.querySelector(".sort-icon");
      if (!icon) return;
      if (i === col) {
        icon.textContent = ascending ? "▲" : "▼";
      } else {
        icon.textContent = "⇕";
      }
    });
  };
})();
</script>

</body>
</html>
