{# FR-11.4 -- Trip index template. Implemented in task T5.4. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trip index &mdash; Raleigh Commute Digital Twin</title>
<style>
  /* ---- Tokens ---- */
  :root {
    --bg:     #f9f8f6;
    --text:   #1a1a1a;
    --accent: #006450;
    --muted:  #888;
    --border: #e0ddd8;
    --gutter: clamp(1.5rem, 4vw, 3rem);
    --max-w:  1000px;
    --f-body: system-ui, "Helvetica Neue", Arial, sans-serif;
    --f-head: Georgia, "Times New Roman", serif;
    --f-mono: "Courier New", Courier, monospace;
  }

  /* ---- Reset ---- */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    font-size: 15px;
    line-height: 1.7;
    font-weight: 400;
    padding-bottom: 6rem;
  }

  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  /* ---- Layout wrapper ---- */
  .wrap {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* ---- Masthead ---- */
  .masthead {
    padding: 2.5rem 0 1.75rem;
    border-bottom: 1px solid var(--border);
  }
  .masthead__kicker {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .masthead__title {
    font-family: var(--f-head);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .masthead__meta {
    margin-top: 0.5rem;
    font-size: 12px;
    color: var(--muted);
    font-family: var(--f-mono);
  }

  /* ---- Summary figures ---- */
  .summary-row {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3.5rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
  }
  .metric-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  .metric-value {
    font-family: var(--f-head);
    font-size: 2.2rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.1;
  }
  .metric-value--accent { color: var(--accent); }
  .metric-sub {
    font-size: 12px;
    color: var(--muted);
    margin-top: 0.25rem;
  }

  /* ---- Section ---- */
  .section { padding: 3rem 0; }

  .section__title {
    font-family: var(--f-head);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--text);
    margin-bottom: 1.5rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--accent);
  }

  /* ---- Trip table ---- */
  .trip-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .trip-table thead th {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-align: left;
    padding: 0 1.25rem 0.6rem 0;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }
  .trip-table thead th:last-child { cursor: default; }
  .trip-table thead th:hover:not(:last-child) { color: var(--text); }
  .sort-icon { font-size: 0.7em; margin-left: 3px; opacity: 0.5; }

  .trip-table tbody tr { border-bottom: 1px solid var(--border); }
  .trip-table tbody tr:last-child { border-bottom: none; }
  .trip-table tbody td {
    padding: 0.7rem 1.25rem 0.7rem 0;
    vertical-align: middle;
  }
  .trip-table tbody td:last-child { padding-right: 0; }

  /* Score inline figure */
  .score-fig {
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 500;
  }
  .score-fig--good { color: #006450; }
  .score-fig--mid  { color: #a05000; }
  .score-fig--poor { color: #8b1a1a; }

  .band-tag {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .star-filled { color: var(--text); }
  .star-empty  { color: var(--border); }
  .no-data     { color: var(--border); }

  /* ---- Empty state ---- */
  .empty-state {
    padding: 2rem 0;
    color: var(--muted);
    font-size: 14px;
  }
  .empty-state code {
    font-family: var(--f-mono);
    color: var(--text);
  }

  /* ---- Footer ---- */
  .page-footer {
    padding: 2rem 0 0;
    font-size: 12px;
    color: var(--muted);
    font-family: var(--f-mono);
    border-top: 1px solid var(--border);
  }

  /* ---- Print ---- */
  @media print {
    body { background: #fff; font-size: 12px; }
    .trip-table thead th { cursor: default; }
  }
</style>
</head>
<body>
<div class="wrap">

  <!-- Masthead -->
  <header class="masthead">
    <div class="masthead__kicker">Raleigh Commute Digital Twin</div>
    <h1 class="masthead__title">Trip index</h1>
    <div class="masthead__meta">Generated {{ generated_at }} &nbsp;&middot;&nbsp; {{ n_trips }} trip(s) scored</div>
  </header>

  <!-- Summary figures -->
  <div class="summary-row">
    <div>
      <div class="metric-label">Trips scored</div>
      <div class="metric-value">{{ n_trips }}</div>
    </div>
    <div>
      <div class="metric-label">Rated</div>
      <div class="metric-value">{{ n_rated }}</div>
    </div>
    {% if rows %}
    <div>
      <div class="metric-label">Average score</div>
      <div class="metric-value metric-value--accent">{{ "%.1f"|format(rows | map(attribute="score_0_100") | list | sum / rows|length) }}</div>
    </div>
    {% endif %}
    <div>
      <div class="metric-label">Spearman &rho; (tool vs. subjective)</div>
      {% if rho_info.rho is not none %}
        <div class="metric-value metric-value--accent" style="font-size: 1.6rem;">{{ "%.3f"|format(rho_info.rho) }}</div>
        <div class="metric-sub">n = {{ rho_info.n }}</div>
      {% else %}
        <div class="metric-value" style="font-size: 1.1rem; color: var(--muted);">n/a</div>
        <div class="metric-sub">need &ge; 5 rated trips (have {{ rho_info.n }})</div>
      {% endif %}
    </div>
  </div>

  <!-- Trip table -->
  <div class="section">
    <h2 class="section__title">All trips</h2>

    {% if rows %}
    <table class="trip-table" id="trip-table">
      <thead>
        <tr>
          <th onclick="sortTable(0)" data-col="0">Trip ID <span class="sort-icon">&#8597;</span></th>
          <th onclick="sortTable(1)" data-col="1">Score <span class="sort-icon">&#8597;</span></th>
          <th onclick="sortTable(2)" data-col="2">Tip % <span class="sort-icon">&#8597;</span></th>
          <th onclick="sortTable(3)" data-col="3">Band <span class="sort-icon">&#8597;</span></th>
          <th onclick="sortTable(4)" data-col="4">Filter <span class="sort-icon">&#8597;</span></th>
          <th onclick="sortTable(5)" data-col="5">Rating <span class="sort-icon">&#8597;</span></th>
          <th onclick="sortTable(6)" data-col="6">Scored at <span class="sort-icon">&#8597;</span></th>
          <th>Report</th>
        </tr>
      </thead>
      <tbody>
      {% for row in rows %}
      <tr>
        <td>{{ row.trip_id }}</td>
        <td>
          {% if row.score_0_100 >= 80 %}
            <span class="score-fig score-fig--good">{{ "%.1f"|format(row.score_0_100) }}</span>
          {% elif row.score_0_100 >= 60 %}
            <span class="score-fig score-fig--mid">{{ "%.1f"|format(row.score_0_100) }}</span>
          {% else %}
            <span class="score-fig score-fig--poor">{{ "%.1f"|format(row.score_0_100) }}</span>
          {% endif %}
        </td>
        <td>{{ row.suggested_tip_pct }}%</td>
        <td><span class="band-tag">{{ row.suggested_tip_band }}</span></td>
        <td style="font-family: var(--f-mono); font-size: 12px; color: var(--muted);">{{ row.fused_source | upper }}</td>
        <td>
          {% if row.rating is not none %}
            <span class="star-filled">{{ "★" * row.rating }}</span><span class="star-empty">{{ "★" * (5 - row.rating) }}</span>
          {% else %}
            <span class="no-data">&mdash;</span>
          {% endif %}
        </td>
        <td style="font-family: var(--f-mono); font-size: 12px; color: var(--muted);">
          {{ row.timestamp_utc[:10] if row.timestamp_utc else "—" }}
        </td>
        <td>
          {% if row.report_link %}
            <a href="{{ row.report_link }}">Open</a>
          {% else %}
            <span class="no-data">&mdash;</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="empty-state">
      No scored trips found. Run <code>make score TRACE=day2</code> first.
    </div>
    {% endif %}
  </div>

  <!-- Footer -->
  <footer class="page-footer">
    Raleigh Commute Digital Twin &nbsp;&middot;&nbsp; {{ generated_at }}
    &nbsp;&middot;&nbsp; Spearman &rho; requires &ge; 5 rated trips.
  </footer>

</div>

<script>
/* Vanilla JS client-side sort -- no framework */
(function () {
  var currentCol = -1;
  var ascending = true;

  window.sortTable = function (col) {
    var table = document.getElementById("trip-table");
    if (!table) return;
    var tbody = table.tBodies[0];
    var rows = Array.from(tbody.querySelectorAll("tr"));

    if (currentCol === col) {
      ascending = !ascending;
    } else {
      currentCol = col;
      ascending = true;
    }

    rows.sort(function (a, b) {
      var aVal = a.cells[col] ? a.cells[col].innerText.trim() : "";
      var bVal = b.cells[col] ? b.cells[col].innerText.trim() : "";
      var aNum = parseFloat(aVal.replace(/[^0-9.\-]/g, ""));
      var bNum = parseFloat(bVal.replace(/[^0-9.\-]/g, ""));
      if (!isNaN(aNum) && !isNaN(bNum)) {
        return ascending ? aNum - bNum : bNum - aNum;
      }
      return ascending ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
    });

    rows.forEach(function (r) { tbody.appendChild(r); });

    var headers = table.querySelectorAll("thead th");
    headers.forEach(function (th, i) {
      var icon = th.querySelector(".sort-icon");
      if (!icon) return;
      icon.textContent = (i === col) ? (ascending ? "▲" : "▼") : "⇕";
    });
  };
})();
</script>

</body>
</html>
