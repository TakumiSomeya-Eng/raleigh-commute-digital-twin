{# FR-11.1 -- Per-trip report template. Implemented in task T5.1. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trip report &mdash; {{ trip_id }}</title>
<style>
  /* ---- Tokens ---- */
  :root {
    --bg:       #f9f8f6;
    --text:     #1a1a1a;
    --accent:   #006450;
    --muted:    #888;
    --border:   #e0ddd8;
    --gutter:   clamp(1.5rem, 4vw, 3rem);
    --max-w:    900px;
    --f-body:   system-ui, "Helvetica Neue", Arial, sans-serif;
    --f-head:   Georgia, "Times New Roman", serif;
    --f-mono:   "Courier New", Courier, monospace;
  }

  /* ---- Reset ---- */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    font-size: 15px;
    line-height: 1.7;
    font-weight: 400;
    padding-bottom: 6rem;
  }

  a { color: var(--accent); }

  /* ---- Layout wrapper ---- */
  .wrap {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* ---- Masthead ---- */
  .masthead {
    padding: 2.5rem 0 1.75rem;
    border-bottom: 1px solid var(--border);
  }
  .masthead__kicker {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .masthead__title {
    font-family: var(--f-head);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .masthead__meta {
    margin-top: 0.5rem;
    font-size: 12px;
    color: var(--muted);
    font-family: var(--f-mono);
  }

  /* ---- Section ---- */
  .section {
    padding: 3rem 0;
    border-bottom: 1px solid var(--border);
  }
  .section:last-of-type { border-bottom: none; }

  .section__title {
    font-family: var(--f-head);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--text);
    margin-bottom: 1.75rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--accent);
  }

  /* ---- Score & tip (two-column) ---- */
  .score-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 560px) {
    .score-row { grid-template-columns: 1fr; gap: 2rem; }
  }

  .metric-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 0.3rem;
  }
  .metric-value {
    font-family: var(--f-head);
    font-size: clamp(2.4rem, 5vw, 3rem);
    font-weight: 500;
    line-height: 1;
  }
  .metric-sub {
    font-size: 13px;
    color: var(--muted);
    margin-top: 0.4rem;
  }

  .callout {
    margin-top: 1.5rem;
    border-left: 3px solid var(--border);
    padding-left: 1rem;
  }
  .callout--warn { border-left-color: #b06000; }
  .callout p {
    font-size: 13px;
    color: #555;
    line-height: 1.6;
  }

  /* ---- Trip stats grid ---- */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1.5rem 2.5rem;
  }
  .stat__label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }
  .stat__value {
    font-family: var(--f-head);
    font-size: 1.7rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.15;
  }
  .stat__unit {
    font-size: 1rem;
    font-weight: 400;
    color: var(--muted);
  }

  /* ---- Bar chart ---- */
  .chart-wrap { overflow-x: auto; }

  /* ---- Map ---- */
  /* Fixed 480px height so content below is not pushed off-screen. */
  .map-wrap {
    height: 480px;
    border: 1px solid var(--border);
    overflow: hidden;
    position: relative;
  }
  .map-wrap > div,
  .map-wrap > div > div {
    width: 100% !important;
    height: 480px !important;
    padding-bottom: 0 !important;
    position: relative !important;
  }
  .map-wrap iframe {
    position: absolute !important;
    width: 100% !important;
    height: 100% !important;
    left: 0 !important;
    top: 0 !important;
  }
  .map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 0.75rem;
    font-size: 12px;
    color: var(--muted);
    align-items: center;
  }
  .legend-swatch {
    display: inline-block;
    width: 22px;
    height: 3px;
    vertical-align: middle;
    margin-right: 5px;
  }

  /* ---- Score detail table ---- */
  .score-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .score-table thead th {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-align: left;
    padding: 0 0 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }
  .score-table thead th:not(:first-child) { text-align: right; }
  .score-table tbody td {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  .score-table tbody td:not(:first-child) {
    text-align: right;
    font-family: var(--f-mono);
    font-size: 13px;
  }
  .score-table tfoot td {
    padding: 0.9rem 0 0;
    font-weight: 500;
  }
  .score-table tfoot td:not(:first-child) {
    text-align: right;
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 500;
  }

  /* ---- Footer ---- */
  .page-footer {
    padding: 2rem 0 0;
    font-size: 12px;
    color: var(--muted);
    font-family: var(--f-mono);
    border-top: 1px solid var(--border);
  }

  /* ---- Print ---- */
  @media print {
    body { background: #fff; font-size: 12px; }
    .section { break-inside: avoid; }
    .map-wrap { height: 380px; }
  }
</style>
</head>
<body>
<div class="wrap">

  <!-- Masthead -->
  <header class="masthead">
    <div class="masthead__kicker">Raleigh Commute Digital Twin</div>
    <h1 class="masthead__title">Trip report &mdash; {{ trip_id }}</h1>
    <div class="masthead__meta">
      Scored {{ timestamp_str }} &nbsp;&middot;&nbsp;
      Filter: {{ fused_source | upper }} &nbsp;&middot;&nbsp;
      Config: {{ config_hash_short }}&hellip;
    </div>
  </header>

  <!-- Score & tip -->
  <section class="section">
    <div class="score-row">
      <div>
        <div class="metric-label">Aggregate score</div>
        <div class="metric-value" style="color: {{ score_color }};">{{ "%.1f"|format(score_0_100) }}</div>
        <div class="metric-sub">out of 100</div>
      </div>
      <div>
        <div>
          <div class="metric-label">Suggested tip</div>
          <div class="metric-value" style="color: var(--text);">{{ suggested_tip_pct }}%</div>
          <div class="metric-sub">Band {{ suggested_tip_band }}</div>
        </div>
        {% if notes %}
        <div class="callout callout--warn">
          <p>{{ notes }}</p>
        </div>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- Trip overview -->
  <section class="section">
    <h2 class="section__title">Trip overview</h2>
    <div class="stats-grid">
      <div>
        <div class="stat__label">Duration</div>
        <div class="stat__value">{{ meta.duration_str }}</div>
      </div>
      <div>
        <div class="stat__label">Distance</div>
        <div class="stat__value">{{ "%.1f"|format(meta.distance_km) }}<span class="stat__unit"> km</span></div>
      </div>
      <div>
        <div class="stat__label">Max speed</div>
        <div class="stat__value">{{ "%.0f"|format(meta.max_speed_kph) }}<span class="stat__unit"> km/h</span></div>
      </div>
      <div>
        <div class="stat__label">Max speed</div>
        <div class="stat__value">{{ "%.0f"|format(meta.max_speed_mph) }}<span class="stat__unit"> mph</span></div>
      </div>
    </div>
  </section>

  <!-- Component breakdown -->
  <section class="section">
    <h2 class="section__title">Component breakdown</h2>
    <div class="chart-wrap">
      {{ bar_svg | safe }}
    </div>
  </section>

  <!-- Route map -->
  <section class="section">
    <h2 class="section__title">Route map</h2>
    <div class="map-wrap">
      {{ map_html | safe }}
    </div>
    <div class="map-legend">
      <span><span class="legend-swatch" style="background: #cc3333;"></span>Actual trajectory</span>
      <span><span class="legend-swatch" style="background: #006450; background: repeating-linear-gradient(90deg, #006450 0, #006450 4px, transparent 4px, transparent 7px);"></span>Ideal trajectory</span>
      <span>&#9679; Start &nbsp; &#9679; End &nbsp; &#9651; Harsh brake</span>
    </div>
  </section>

  <!-- Score detail -->
  <section class="section">
    <h2 class="section__title">Score detail</h2>
    <table class="score-table">
      <thead>
        <tr>
          <th>Component</th>
          <th>Raw penalty</th>
          <th>Weight</th>
          <th>Weighted</th>
        </tr>
      </thead>
      <tbody>
        {% set label_map = {
          "jerk":        "Jerk",
          "harsh_brake": "Harsh braking",
          "lat_accel":   "Lateral acceleration",
          "speed":       "Speed compliance",
          "deviation":   "Route deviation",
          "lane_change": "Lane changes"
        } %}
        {% for name, comp in score_doc.components.items() %}
        <tr>
          <td>{{ label_map.get(name, name) }}</td>
          <td>{{ "%.4f"|format(comp.raw) }}</td>
          <td style="color: var(--muted);">{{ "%.2f"|format(comp.weight) }}</td>
          <td>{{ "%.4f"|format(comp.weighted) }}</td>
        </tr>
        {% endfor %}
      </tbody>
      <tfoot>
        <tr>
          <td>Aggregate</td>
          <td>{{ "%.4f"|format(aggregate_raw) }}</td>
          <td style="color: var(--muted);">1.00</td>
          <td style="color: {{ score_color }};">{{ "%.1f"|format(score_0_100) }} / 100</td>
        </tr>
      </tfoot>
    </table>
  </section>

  <!-- Footer -->
  <footer class="page-footer">
    Raleigh Commute Digital Twin &nbsp;&middot;&nbsp;
    {{ timestamp_str }} &nbsp;&middot;&nbsp;
    config sha256: {{ config_hash_short }}&hellip;
  </footer>

</div>
</body>
</html>
